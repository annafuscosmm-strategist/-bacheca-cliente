{
 "name": "reel3",
 "title": "Perché il respiro libera\nil pavimento pelvico",
 "start": 514.3,
 "dur": 82.7,
 "cues": [
  [
   0.2,
   5.5,
   "Tutti i visceri sono sospesi,",
   "legati gli uni agli altri da legamenti."
  ],
  [
   5.5,
   11.2,
   "Il contenuto dell'addome è sospeso",
   "al movimento del diaframma."
  ],
  [
   11.8,
   15.1,
   "Quando il diaframma scende,",
   "tutto scende."
  ],
  [
   15.1,
   20.0,
   "Quando il diaframma sale, tutto sale,",
   "anche il pavimento pelvico."
  ],
  [
   20.0,
   25.3,
   "Quindi il primo modo di lavorare",
   "sul pavimento pelvico è lasciarlo stare."
  ],
  [
   25.7,
   28.1,
   "Bisogna lavorare sul respiro.",
   ""
  ],
  [
   28.1,
   34.5,
   "Noi insegnanti, soprattutto di Pilates,",
   "diciamo: «attiva il pelvico, stringi»."
  ],
  [
   34.6,
   43.9,
   "Se ci concentrassimo più sul respiro",
   "e meno sul pavimento pelvico,"
  ],
  [
   43.9,
   49.7,
   "vedremmo che quando il diaframma sale,",
   "le pelvi salgono da sole."
  ],
  [
   50.0,
   53.1,
   "Quando il diaframma scende,",
   "le pelvi scendono."
  ],
  [
   53.1,
   60.8,
   "Ripristinare un corretto respiro",
   "libera il nostro pavimento pelvico."
  ],
  [
   64.1,
   68.2,
   "Lasciatelo un attimo stare lì,",
   "tranquillo."
  ],
  [
   69.9,
   75.0,
   "Nell'inspirazione il diaframma scende",
   "e spinge i visceri in basso e in avanti,"
  ],
  [
   75.0,
   82.2,
   "con l'azione del trasverso addominale,",
   "fondamentale in questo caso."
  ]
 ]
